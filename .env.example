# Upstash Redis — required for live sync when deployed to Vercel (free tier).
# Create a free database at https://upstash.com and copy the REST values here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: protect the facilitator controls. Students never need this.
# If unset, the /host controls are open (fine for quick local use).
HOST_TOKEN=

# Optional: AI reviewer for code/text answers (free-tier Google Gemini).
# Get a key at https://aistudio.google.com/app/apikey
# If unset, code/text answers are scored only by the facilitator (0-10 slider).
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash

